  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "supabase db reset && supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/types.ts",
